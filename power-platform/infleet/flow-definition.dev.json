        "runAfter": {
          "Mapear_Motoristas_Infleet": ["Succeeded"]
        }
      },
      "Continuar_Apos_Telemetria": {
        "type": "Compose",
        "inputs": "@if(equals(actions('Processar_Ultimos_3_Dias').status,'Succeeded'),'TELEMETRIA_OK','TELEMETRIA_PARCIAL')",
        "runAfter": {
          "Processar_Ultimos_3_Dias": ["Succeeded", "Failed", "Skipped", "TimedOut"]
        }
      },
      "Janela_Viagens_Inicio_UTC": {
        "type": "Compose",
        "inputs": "@convertTimeZone(concat(formatDateTime(addDays(convertTimeZone(utcNow(),'UTC','E. South America Standard Time'),-2),'yyyy-MM-dd'),'T00:00:00'),'E. South America Standard Time','UTC','yyyy-MM-ddTHH:mm:ssZ')",
        "runAfter": {
          "Continuar_Apos_Telemetria": ["Succeeded"]
        }
      },
      "Janela_Viagens_Fim_UTC": {
        "type": "Compose",
        "inputs": "@convertTimeZone(concat(formatDateTime(addDays(convertTimeZone(utcNow(),'UTC','E. South America Standard Time'),1),'yyyy-MM-dd'),'T00:00:00'),'E. South America Standard Time','UTC','yyyy-MM-ddTHH:mm:ssZ')",
        "runAfter": {
          "Janela_Viagens_Inicio_UTC": ["Succeeded"]
        }
      },
      "Processar_Viagens_Por_Veiculo": {
        "type": "Foreach",
        "foreach": "@body('Listar_Veiculos_Infleet')?['data']?['listVehicles']",
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 3
          }
        },
        "actions": {
          "Filtrar_Veiculo_Dataverse_Viagem": {
            "type": "Query",
            "inputs": {
              "from": "@body('Listar_Veiculos_Dataverse')?['value']",
              "where": "@equals(toUpper(replace(replace(trim(coalesce(item()?['cr40f_placa'],'')),'-',''),' ','')),toUpper(replace(replace(trim(coalesce(items('Processar_Viagens_Por_Veiculo')?['plate'],'')),'-',''),' ','')))"
            }
          },
          "Veiculo_Viagem_Canonico_Unico": {
            "type": "If",
            "expression": {
              "equals": [
                "@length(body('Filtrar_Veiculo_Dataverse_Viagem'))",
                1
              ]
            },
            "actions": {
              "Listar_Viagens_Infleet": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/__INFLEET_API_NAME__",
                    "connectionName": "__INFLEET_CONNECTION_REFERENCE__",
                    "operationId": "ExecuteGraphQL"
                  },
                  "parameters": {
                    "body/operationName": "Trips",
                    "body/query": "query Trips($filter: ListVehicleTripsFilterInput!) { trips(filter: $filter) { id startedAt finishedAt distanceTraveled averageSpeed maximumSpeed timeAboveMaxConfSpeed fuelConsumedLiters fuelConsumedPrice driver { id cpf name } vehicle { id plate } } }",
                    "body/variables": {
                      "filter": {
                        "vehicleId": "@items('Processar_Viagens_Por_Veiculo')?['id']",
                        "fixTime": {
                          "startAt": "@outputs('Janela_Viagens_Inicio_UTC')",
                          "endAt": "@outputs('Janela_Viagens_Fim_UTC')"
                        }
                      }
                    }
                  }
                }
              },
              "Processar_Viagens": {
                "type": "Foreach",
                "foreach": "@body('Listar_Viagens_Infleet')?['data']?['trips']",
                "runtimeConfiguration": {
                  "concurrency": {
                    "repetitions": 10
                  }
                },
                "actions": {
                  "Filtrar_Motorista_Dataverse_Viagem": {
                    "type": "Query",
                    "inputs": {
                      "from": "@body('Listar_Motoristas_Dataverse')?['value']",
                      "where": "@or(and(not(empty(items('Processar_Viagens')?['driver']?['id'])),equals(item()?['new_infleetdriverid'],items('Processar_Viagens')?['driver']?['id'])),and(not(empty(items('Processar_Viagens')?['driver']?['cpf'])),equals(replace(replace(replace(trim(coalesce(item()?['cr40f_numerodocpf'],'')),'.',''),'-',''),' ',''),replace(replace(replace(trim(items('Processar_Viagens')?['driver']?['cpf']),'.',''),'-',''),' ',''))))"
                    }
                  },
                  "Motorista_Viagem_Canonico_Unico": {
                    "type": "If",
                    "expression": {
                      "equals": [
                        "@length(body('Filtrar_Motorista_Dataverse_Viagem'))",
                        1
                      ]
                    },
                    "actions": {
                      "Atualizar_Mapeamento_Motorista_Viagem": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                            "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
                            "operationId": "UpdateRecord"
                          },
                          "parameters": {
                            "entityName": "cr40f_funcionarioses",
                            "recordId": "@first(body('Filtrar_Motorista_Dataverse_Viagem'))?['cr40f_funcionariosid']",
                            "prefer": "return=representation",
                            "accept": "application/json;odata.metadata=full",
                            "item": {
                              "new_infleetdriverid": "@items('Processar_Viagens')?['driver']?['id']",
                              "new_cpfnormalizado": "@replace(replace(replace(items('Processar_Viagens')?['driver']?['cpf'],'.',''),'-',''),' ','')",
                              "new_ultimasincronizacaoinfleet": "@utcNow()"
                            }
                          }
                        }
                      },
                      "Upsert_Viagem_Com_Motorista": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                            "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
                            "operationId": "UpdateRecord"
                          },
                          "parameters": {
                            "entityName": "new_viageminfleets",
                            "recordId": "@concat(substring(items('Processar_Viagens_Por_Veiculo')?['id'],0,24),formatDateTime(items('Processar_Viagens')?['startedAt'],'yyMMddHHmmss'))",
                            "prefer": "return=representation",
                            "accept": "application/json;odata.metadata=full",
                            "item": {
                              "new_nome": "@concat(items('Processar_Viagens_Por_Veiculo')?['plate'],' | ',items('Processar_Viagens')?['startedAt'])",
                              "new_infleettripid": "@concat(items('Processar_Viagens_Por_Veiculo')?['id'],'|',items('Processar_Viagens')?['startedAt'])",
                              "new_infleetvehicleid": "@items('Processar_Viagens_Por_Veiculo')?['id']",
                              "new_infleetdriverid": "@items('Processar_Viagens')?['driver']?['id']",
                              "new_placanormalizada": "@toUpper(replace(items('Processar_Viagens_Por_Veiculo')?['plate'],'-',''))",
                              "new_nomemotoristarecebido": "@items('Processar_Viagens')?['driver']?['name']",
                              "new_iniciadoem": "@items('Processar_Viagens')?['startedAt']",
                              "new_finalizadoem": "@items('Processar_Viagens')?['finishedAt']",
                              "new_distanciakm": "@coalesce(items('Processar_Viagens')?['distanceTraveled'],0)",
                              "new_velocidademedia": "@coalesce(items('Processar_Viagens')?['averageSpeed'],0)",
                              "new_velocidademaxima": "@coalesce(items('Processar_Viagens')?['maximumSpeed'],0)",
                              "new_tempoacimavelocidademin": "@int(div(coalesce(items('Processar_Viagens')?['timeAboveMaxConfSpeed'],0),60))",
                              "new_combustivelconsumidolitros": "@coalesce(items('Processar_Viagens')?['fuelConsumedLiters'],0)",
                              "new_custocombustivelconsumido": "@coalesce(items('Processar_Viagens')?['fuelConsumedPrice'],0)",
                              "new_autonomiakml": "@if(greater(coalesce(items('Processar_Viagens')?['fuelConsumedLiters'],0),0),div(coalesce(items('Processar_Viagens')?['distanceTraveled'],0),items('Processar_Viagens')?['fuelConsumedLiters']),null)",
                              "new_statusmapeamentomotorista": "MAPEADO",
                              "new_sincronizadoem": "@utcNow()",
                              "new_Veiculo@odata.bind": "@concat('/cr40f_veiculoses(',first(body('Filtrar_Veiculo_Dataverse_Viagem'))?['cr40f_veiculosid'],')')",
                              "new_Motorista@odata.bind": "@concat('/cr40f_funcionarioses(',first(body('Filtrar_Motorista_Dataverse_Viagem'))?['cr40f_funcionariosid'],')')"
                            }
                          }
                        },
                        "runAfter": {
                          "Atualizar_Mapeamento_Motorista_Viagem": ["Succeeded"]
                        }
                      }
                    },
                    "else": {
                      "actions": {
                        "Upsert_Viagem_Sem_Motorista": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                              "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
                              "operationId": "UpdateRecord"
                            },
                            "parameters": {
                              "entityName": "new_viageminfleets",
                              "recordId": "@concat(substring(items('Processar_Viagens_Por_Veiculo')?['id'],0,24),formatDateTime(items('Processar_Viagens')?['startedAt'],'yyMMddHHmmss'))",
                              "prefer": "return=representation",
                              "accept": "application/json;odata.metadata=full",
                              "item": {
                                "new_nome": "@concat(items('Processar_Viagens_Por_Veiculo')?['plate'],' | ',items('Processar_Viagens')?['startedAt'])",
                                "new_infleettripid": "@concat(items('Processar_Viagens_Por_Veiculo')?['id'],'|',items('Processar_Viagens')?['startedAt'])",
                                "new_infleetvehicleid": "@items('Processar_Viagens_Por_Veiculo')?['id']",
                                "new_infleetdriverid": "@items('Processar_Viagens')?['driver']?['id']",
                                "new_placanormalizada": "@toUpper(replace(items('Processar_Viagens_Por_Veiculo')?['plate'],'-',''))",
                                "new_nomemotoristarecebido": "@items('Processar_Viagens')?['driver']?['name']",
                                "new_iniciadoem": "@items('Processar_Viagens')?['startedAt']",
                                "new_finalizadoem": "@items('Processar_Viagens')?['finishedAt']",
                                "new_distanciakm": "@coalesce(items('Processar_Viagens')?['distanceTraveled'],0)",
                                "new_velocidademedia": "@coalesce(items('Processar_Viagens')?['averageSpeed'],0)",
                                "new_velocidademaxima": "@coalesce(items('Processar_Viagens')?['maximumSpeed'],0)",
                                "new_tempoacimavelocidademin": "@int(div(coalesce(items('Processar_Viagens')?['timeAboveMaxConfSpeed'],0),60))",
                                "new_combustivelconsumidolitros": "@coalesce(items('Processar_Viagens')?['fuelConsumedLiters'],0)",
                                "new_custocombustivelconsumido": "@coalesce(items('Processar_Viagens')?['fuelConsumedPrice'],0)",
                                "new_autonomiakml": "@if(greater(coalesce(items('Processar_Viagens')?['fuelConsumedLiters'],0),0),div(coalesce(items('Processar_Viagens')?['distanceTraveled'],0),items('Processar_Viagens')?['fuelConsumedLiters']),null)",
                                "new_statusmapeamentomotorista": "@if(empty(items('Processar_Viagens')?['driver']?['id']),'SEM_MOTORISTA',if(equals(length(body('Filtrar_Motorista_Dataverse_Viagem')),0),'NAO_ENCONTRADO','DUPLICADO'))",
                                "new_sincronizadoem": "@utcNow()",
                                "new_Veiculo@odata.bind": "@concat('/cr40f_veiculoses(',first(body('Filtrar_Veiculo_Dataverse_Viagem'))?['cr40f_veiculosid'],')')"
                              }
                            }
                          }
                        }
                      }
                    },
                    "runAfter": {
                      "Filtrar_Motorista_Dataverse_Viagem": ["Succeeded"]
                    }
                  }
                },
                "runAfter": {
                  "Listar_Viagens_Infleet": ["Succeeded"]
                }
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Filtrar_Veiculo_Dataverse_Viagem": ["Succeeded"]
            }
          }
        },
        "runAfter": {
          "Janela_Viagens_Fim_UTC": ["Succeeded"]
        }
