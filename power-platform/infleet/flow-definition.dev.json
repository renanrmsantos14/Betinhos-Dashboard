                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
                                "operationId": "UpdateRecord"
                              },
                              "parameters": {
                                "entityName": "new_eventoinfleets",
                                "recordId": "@items('Processar_Eventos')?['id']",
                                "prefer": "return=representation",
                                "accept": "application/json;odata.metadata=full",
                                "item": {
                                  "new_nome": "@concat(items('Processar_Eventos')?['slugName'],' | ',items('Processar_Eventos')?['reportedAt'])",
                                  "new_infleeteventid": "@items('Processar_Eventos')?['id']",
                                  "new_infleetvehicleid": "@items('Processar_Eventos')?['vehicleId']",
                                  "new_infleetdriverid": "@outputs('Motorista_Resolvido')?['id']",
                                  "new_placanormalizada": "@toUpper(replace(items('Processar_Eventos')?['vehicle']?['plate'],'-',''))",
                                  "new_nomemotoristarecebido": "@outputs('Motorista_Resolvido')?['name']",
                                  "new_slug": "@items('Processar_Eventos')?['slugName']",
                                  "new_descricao": "@items('Processar_Eventos')?['slugName']",
                                  "new_reportadoem": "@items('Processar_Eventos')?['reportedAt']",
                                  "new_velocidaderegistrada": "@coalesce(items('Processar_Eventos')?['attributes']?['speed'],items('Processar_Eventos')?['attributes']?['velocity'],0)",
                                  "new_limitedevelocidade": "@coalesce(items('Processar_Eventos')?['geofence']?['maxSpeed'],0)",
                                  "new_endereco": "@items('Processar_Eventos')?['address']",
                                  "new_latitude": "@items('Processar_Eventos')?['latitude']",
                                  "new_longitude": "@items('Processar_Eventos')?['longitude']",
                                  "new_cerca": "@items('Processar_Eventos')?['geofence']?['name']",
                                  "new_alarme": "@coalesce(items('Processar_Eventos')?['isAlarm'],false)",
                                  "new_statusmapeamentomotorista": "MAPEADO",
                                  "new_sincronizadoem": "@utcNow()",
                                  "new_Veiculo@odata.bind": "@concat('/cr40f_veiculoses(',first(body('Filtrar_Veiculo_Dataverse'))?['cr40f_veiculosid'],')')",
                                  "new_Motorista@odata.bind": "@concat('/cr40f_funcionarioses(',first(body('Filtrar_Motorista_Dataverse'))?['cr40f_funcionariosid'],')')"
                                }
                              }
                            },
                            "runAfter": {
                              "Atualizar_Mapeamento_Motorista": ["Succeeded"]
                            }
                          }
                        },
                        "else": {
                          "actions": {
                            "Upsert_Evento_Sem_Motorista": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                  "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
                                  "operationId": "UpdateRecord"
                                },
                                "parameters": {
                                  "entityName": "new_eventoinfleets",
                                  "recordId": "@items('Processar_Eventos')?['id']",
                                  "prefer": "return=representation",
                                  "accept": "application/json;odata.metadata=full",
                                  "item": {
                                    "new_nome": "@concat(items('Processar_Eventos')?['slugName'],' | ',items('Processar_Eventos')?['reportedAt'])",
                                    "new_infleeteventid": "@items('Processar_Eventos')?['id']",
                                    "new_infleetvehicleid": "@items('Processar_Eventos')?['vehicleId']",
                                    "new_infleetdriverid": "@outputs('Motorista_Resolvido')?['id']",
                                    "new_placanormalizada": "@toUpper(replace(items('Processar_Eventos')?['vehicle']?['plate'],'-',''))",
                                    "new_nomemotoristarecebido": "@outputs('Motorista_Resolvido')?['name']",
                                    "new_slug": "@items('Processar_Eventos')?['slugName']",
                                    "new_descricao": "@items('Processar_Eventos')?['slugName']",
                                    "new_reportadoem": "@items('Processar_Eventos')?['reportedAt']",
                                    "new_velocidaderegistrada": "@coalesce(items('Processar_Eventos')?['attributes']?['speed'],items('Processar_Eventos')?['attributes']?['velocity'],0)",
                                    "new_limitedevelocidade": "@coalesce(items('Processar_Eventos')?['geofence']?['maxSpeed'],0)",
                                    "new_endereco": "@items('Processar_Eventos')?['address']",
                                    "new_latitude": "@items('Processar_Eventos')?['latitude']",
                                    "new_longitude": "@items('Processar_Eventos')?['longitude']",
                                    "new_cerca": "@items('Processar_Eventos')?['geofence']?['name']",
                                    "new_alarme": "@coalesce(items('Processar_Eventos')?['isAlarm'],false)",
                                    "new_statusmapeamentomotorista": "@if(empty(outputs('Motorista_Resolvido')?['id']),'SEM_MOTORISTA',if(equals(length(body('Filtrar_Motorista_Dataverse')),0),'NAO_ENCONTRADO','DUPLICADO'))",
                                    "new_sincronizadoem": "@utcNow()",
                                    "new_Veiculo@odata.bind": "@concat('/cr40f_veiculoses(',first(body('Filtrar_Veiculo_Dataverse'))?['cr40f_veiculosid'],')')"
                                  }
                                }
                              }
                            }
                          }
                        },
                        "runAfter": {
