{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      }
    },
    "triggers": {
      "Recorrencia_Diaria": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Day",
          "interval": 1,
          "schedule": {
            "hours": [4],
            "minutes": [0]
          },
          "timeZone": "E. South America Standard Time"
        },
        "runtimeConfiguration": {
          "concurrency": {
            "runs": 1
          }
        }
      }
    },
    "actions": {
      "Listar_Veiculos_Infleet": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/__INFLEET_API_NAME__",
            "connectionName": "__INFLEET_CONNECTION_REFERENCE__",
            "operationId": "ExecuteGraphQL"
          },
          "parameters": {
            "body/operationName": "ListVehicles",
            "body/query": "query ListVehicles { listVehicles(limit: 1000) { id plate displayName brand model year } }",
            "body/variables": {}
          }
        },
        "runAfter": {}
      },
      "Selecionar_Ids_Veiculos": {
        "type": "Select",
        "inputs": {
          "from": "@body('Listar_Veiculos_Infleet')?['data']?['listVehicles']",
          "select": "@item()?['id']"
        },
        "runAfter": {
          "Listar_Veiculos_Infleet": ["Succeeded"]
        }
      },
      "Listar_Veiculos_Dataverse": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
            "operationId": "ListRecords"
          },
          "parameters": {
            "entityName": "cr40f_veiculoses",
            "$select": "cr40f_veiculosid,cr40f_placa,new_infleetvehicleid,new_placanormalizada"
          }
        },
        "runtimeConfiguration": {
          "paginationPolicy": {
            "minimumItemCount": 5000
          }
        },
        "runAfter": {
          "Selecionar_Ids_Veiculos": ["Succeeded"]
        }
      },
      "Listar_Motoristas_Dataverse": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
            "operationId": "ListRecords"
          },
          "parameters": {
            "entityName": "cr40f_funcionarioses",
            "$select": "cr40f_funcionariosid,cr40f_numerodocpf,new_infleetdriverid,new_cpfnormalizado"
          }
        },
        "runtimeConfiguration": {
          "paginationPolicy": {
            "minimumItemCount": 5000
          }
        },
        "runAfter": {
          "Listar_Veiculos_Dataverse": ["Succeeded"]
        }
      },
      "Processar_Ultimos_3_Dias": {
        "type": "Foreach",
        "foreach": "@createArray(-2,-1,0)",
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 1
          }
        },
        "actions": {
          "Data_Local": {
            "type": "Compose",
            "inputs": "@formatDateTime(addDays(convertTimeZone(utcNow(),'UTC','E. South America Standard Time'),items('Processar_Ultimos_3_Dias')),'yyyy-MM-dd')"
          },
          "Janela_Inicio_UTC": {
            "type": "Compose",
            "inputs": "@convertTimeZone(concat(outputs('Data_Local'),'T00:00:00'),'E. South America Standard Time','UTC','yyyy-MM-ddTHH:mm:ssZ')",
            "runAfter": {
              "Data_Local": ["Succeeded"]
            }
          },
          "Janela_Fim_UTC": {
            "type": "Compose",
            "inputs": "@convertTimeZone(concat(formatDateTime(addDays(outputs('Data_Local'),1),'yyyy-MM-dd'),'T00:00:00'),'E. South America Standard Time','UTC','yyyy-MM-ddTHH:mm:ssZ')",
            "runAfter": {
              "Janela_Inicio_UTC": ["Succeeded"]
            }
          },
          "Listar_Eventos_Relevantes_Infleet": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/__INFLEET_API_NAME__",
                "connectionName": "__INFLEET_CONNECTION_REFERENCE__",
                "operationId": "ExecuteGraphQL"
              },
              "parameters": {
                "body/operationName": "ListRelevantEvents",
                "body/query": "query ListRelevantEvents($filter: ListEventsFilterInput!, $limit: Int, $offset: Int) { listEvents(filter: $filter, limit: $limit, offset: $offset) { id reportedAt slugName vehicleId address latitude longitude isAlarm attributes vehicle { id plate } driverId driver { id cpf name } geofence { name maxSpeed } } }",
                "body/variables": {
                    "filter": {
                      "reportedAt": {
                        "startAt": "@outputs('Janela_Inicio_UTC')",
                        "endAt": "@outputs('Janela_Fim_UTC')"
                      },
                      "slugNames": [
                        "routeOverspeed",
                        "deviceOverspeed",
                        "hardAcceleration",
                        "hardBraking",
                        "hardCornering",
                        "deviceIdle",
                        "geofenceEnter",
                        "geofenceExit",
                        "driverChanged"
                      ],
                      "vehicleIds": "@body('Selecionar_Ids_Veiculos')"
                    },
                    "limit": 10000,
                    "offset": 0
                }
              }
            },
            "runAfter": {
              "Janela_Fim_UTC": ["Succeeded"]
            }
          },
          "Processar_Veiculos": {
            "type": "Foreach",
            "foreach": "@body('Listar_Veiculos_Infleet')?['data']?['listVehicles']",
            "runtimeConfiguration": {
              "concurrency": {
                "repetitions": 3
              }
            },
            "actions": {
              "Filtrar_Veiculo_Dataverse": {
                "type": "Query",
                "inputs": {
                  "from": "@body('Listar_Veiculos_Dataverse')?['value']",
                  "where": "@equals(toUpper(replace(replace(trim(coalesce(item()?['cr40f_placa'],'')),'-',''),' ','')),toUpper(replace(replace(trim(coalesce(items('Processar_Veiculos')?['plate'],'')),'-',''),' ','')))"
                }
              },
              "Veiculo_Canonico_Unico": {
                "type": "If",
                "expression": {
                  "equals": [
                    "@length(body('Filtrar_Veiculo_Dataverse'))",
                    1
                  ]
                },
                "actions": {
                  "Atualizar_Mapeamento_Veiculo": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
                        "operationId": "UpdateRecord"
                      },
                      "parameters": {
                        "entityName": "cr40f_veiculoses",
                        "recordId": "@first(body('Filtrar_Veiculo_Dataverse'))?['cr40f_veiculosid']",
                        "prefer": "return=representation",
                        "accept": "application/json;odata.metadata=full",
                        "item": {
                          "new_infleetvehicleid": "@items('Processar_Veiculos')?['id']",
                          "new_placanormalizada": "@toUpper(replace(items('Processar_Veiculos')?['plate'],'-',''))",
                          "new_ultimasincronizacaoinfleet": "@utcNow()"
                        }
                      }
                    }
                  },
                  "Obter_Detalhes_Rota_Infleet": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/__INFLEET_API_NAME__",
                        "connectionName": "__INFLEET_CONNECTION_REFERENCE__",
                        "operationId": "ExecuteGraphQL"
                      },
                      "parameters": {
                        "body/operationName": "RouteVehicleDetails",
                        "body/query": "query RouteVehicleDetails($filter: ListVehiclePositionsFilterInput!) { routeVehicleDetails(filter: $filter) { averageSpeed maximumSpeed totalDistanceTraveled totalTimeStopped totalTimeStoppedWithIgnitionOn totalTimeWithIgnitionOn } }",
                        "body/variables": {
                            "filter": {
                              "vehicleId": "@items('Processar_Veiculos')?['id']",
                              "fixTime": {
                                "startAt": "@outputs('Janela_Inicio_UTC')",
                                "endAt": "@outputs('Janela_Fim_UTC')"
                              }
                            }
                        }
                      }
                    },
                    "runAfter": {
                      "Atualizar_Mapeamento_Veiculo": ["Succeeded"]
                    }
                  },
                  "Filtrar_Eventos_Veiculo": {
                    "type": "Query",
                    "inputs": {
                      "from": "@body('Listar_Eventos_Relevantes_Infleet')?['data']?['listEvents']",
                      "where": "@equals(item()?['vehicleId'],items('Processar_Veiculos')?['id'])"
                    },
                    "runAfter": {
                      "Obter_Detalhes_Rota_Infleet": ["Succeeded"]
                    }
                  },
                  "Filtrar_Excessos_Velocidade": {
                    "type": "Query",
                    "inputs": {
                      "from": "@body('Filtrar_Eventos_Veiculo')",
                      "where": "@or(equals(item()?['slugName'],'routeOverspeed'),equals(item()?['slugName'],'deviceOverspeed'))"
                    },
                    "runAfter": {
                      "Filtrar_Eventos_Veiculo": ["Succeeded"]
                    }
                  },
                  "Upsert_Resumo_Diario": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
                        "operationId": "UpdateRecord"
                      },
                      "parameters": {
                        "entityName": "new_telemetriadiariainfleets",
                        "recordId": "@concat(substring(items('Processar_Veiculos')?['id'],0,28),replace(outputs('Data_Local'),'-',''))",
                        "prefer": "return=representation",
                        "accept": "application/json;odata.metadata=full",
                        "item": {
                          "new_nome": "@concat(items('Processar_Veiculos')?['plate'],' | ',outputs('Data_Local'))",
                          "new_chavetelemetria": "@concat(items('Processar_Veiculos')?['id'],'|',outputs('Data_Local'))",
                          "new_infleetvehicleid": "@items('Processar_Veiculos')?['id']",
                          "new_placanormalizada": "@toUpper(replace(items('Processar_Veiculos')?['plate'],'-',''))",
                          "new_data": "@outputs('Data_Local')",
                          "new_distanciapercorridakm": "@coalesce(body('Obter_Detalhes_Rota_Infleet')?['data']?['routeVehicleDetails']?['totalDistanceTraveled'],0)",
                          "new_velocidademedia": "@coalesce(body('Obter_Detalhes_Rota_Infleet')?['data']?['routeVehicleDetails']?['averageSpeed'],0)",
                          "new_velocidademaxima": "@coalesce(body('Obter_Detalhes_Rota_Infleet')?['data']?['routeVehicleDetails']?['maximumSpeed'],0)",
                          "new_tempoemmovimentomin": "@div(sub(coalesce(body('Obter_Detalhes_Rota_Infleet')?['data']?['routeVehicleDetails']?['totalTimeWithIgnitionOn'],0),coalesce(body('Obter_Detalhes_Rota_Infleet')?['data']?['routeVehicleDetails']?['totalTimeStoppedWithIgnitionOn'],0)),60)",
                          "new_tempoparadomin": "@div(coalesce(body('Obter_Detalhes_Rota_Infleet')?['data']?['routeVehicleDetails']?['totalTimeStopped'],0),60)",
                          "new_tempoparadocomignicaomin": "@div(coalesce(body('Obter_Detalhes_Rota_Infleet')?['data']?['routeVehicleDetails']?['totalTimeStoppedWithIgnitionOn'],0),60)",
                          "new_tempocomignicaoligadamin": "@div(coalesce(body('Obter_Detalhes_Rota_Infleet')?['data']?['routeVehicleDetails']?['totalTimeWithIgnitionOn'],0),60)",
                          "new_quantidadeeventos": "@length(body('Filtrar_Eventos_Veiculo'))",
                          "new_excessosdevelocidade": "@length(body('Filtrar_Excessos_Velocidade'))",
                          "new_janelainicioutc": "@outputs('Janela_Inicio_UTC')",
                          "new_janelafimutc": "@outputs('Janela_Fim_UTC')",
                          "new_sincronizadoem": "@utcNow()",
                          "new_Veiculo@odata.bind": "@concat('/cr40f_veiculoses(',first(body('Filtrar_Veiculo_Dataverse'))?['cr40f_veiculosid'],')')"
                        }
                      }
                    },
                    "runAfter": {
                      "Filtrar_Excessos_Velocidade": ["Succeeded"]
                    }
                  },
                  "Processar_Eventos": {
                    "type": "Foreach",
                    "foreach": "@body('Filtrar_Eventos_Veiculo')",
                    "runtimeConfiguration": {
                      "concurrency": {
                        "repetitions": 20
                      }
                    },
                    "actions": {
                      "Filtrar_Motorista_Dataverse": {
                        "type": "Query",
                        "inputs": {
                          "from": "@body('Listar_Motoristas_Dataverse')?['value']",
                          "where": "@or(and(not(empty(coalesce(items('Processar_Eventos')?['driver']?['id'],items('Processar_Eventos')?['driverId']))),equals(item()?['new_infleetdriverid'],coalesce(items('Processar_Eventos')?['driver']?['id'],items('Processar_Eventos')?['driverId']))),and(not(empty(items('Processar_Eventos')?['driver']?['cpf'])),equals(replace(replace(replace(trim(coalesce(item()?['cr40f_numerodocpf'],'')),'.',''),'-',''),' ',''),replace(replace(replace(trim(items('Processar_Eventos')?['driver']?['cpf']),'.',''),'-',''),' ',''))))"
                        }
                      },
                      "Motorista_Canonico_Unico": {
                        "type": "If",
                        "expression": {
                          "equals": [
                            "@length(body('Filtrar_Motorista_Dataverse'))",
                            1
                          ]
                        },
                        "actions": {
                          "Atualizar_Mapeamento_Motorista": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
                                "operationId": "UpdateRecord"
                              },
                              "parameters": {
                                "entityName": "cr40f_funcionarioses",
                                "recordId": "@first(body('Filtrar_Motorista_Dataverse'))?['cr40f_funcionariosid']",
                                "prefer": "return=representation",
                                "accept": "application/json;odata.metadata=full",
                                "item": {
                                  "new_infleetdriverid": "@coalesce(items('Processar_Eventos')?['driver']?['id'],items('Processar_Eventos')?['driverId'])",
                                  "new_cpfnormalizado": "@replace(replace(replace(items('Processar_Eventos')?['driver']?['cpf'],'.',''),'-',''),' ','')",
                                  "new_ultimasincronizacaoinfleet": "@utcNow()"
                                }
                              }
                            }
                          },
                          "Upsert_Evento_Com_Motorista": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
                                "operationId": "UpdateRecord"
                              },
                              "parameters": {
                                "entityName": "new_eventoinfleets",
                                "recordId": "@items('Processar_Eventos')?['id']",
                                "prefer": "return=representation",
                                "accept": "application/json;odata.metadata=full",
                                "item": {
                                  "new_nome": "@concat(items('Processar_Eventos')?['slugName'],' | ',items('Processar_Eventos')?['reportedAt'])",
                                  "new_infleeteventid": "@items('Processar_Eventos')?['id']",
                                  "new_infleetvehicleid": "@items('Processar_Eventos')?['vehicleId']",
                                  "new_infleetdriverid": "@coalesce(items('Processar_Eventos')?['driver']?['id'],items('Processar_Eventos')?['driverId'])",
                                  "new_placanormalizada": "@toUpper(replace(items('Processar_Eventos')?['vehicle']?['plate'],'-',''))",
                                  "new_nomemotoristarecebido": "@items('Processar_Eventos')?['driver']?['name']",
                                  "new_slug": "@items('Processar_Eventos')?['slugName']",
                                  "new_descricao": "@items('Processar_Eventos')?['slugName']",
                                  "new_reportadoem": "@items('Processar_Eventos')?['reportedAt']",
                                  "new_velocidaderegistrada": "@coalesce(items('Processar_Eventos')?['attributes']?['speed'],items('Processar_Eventos')?['attributes']?['velocity'],0)",
                                  "new_limitedevelocidade": "@coalesce(items('Processar_Eventos')?['geofence']?['maxSpeed'],0)",
                                  "new_endereco": "@items('Processar_Eventos')?['address']",
                                  "new_latitude": "@items('Processar_Eventos')?['latitude']",
                                  "new_longitude": "@items('Processar_Eventos')?['longitude']",
                                  "new_cerca": "@items('Processar_Eventos')?['geofence']?['name']",
                                  "new_alarme": "@coalesce(items('Processar_Eventos')?['isAlarm'],false)",
                                  "new_statusmapeamentomotorista": "MAPEADO",
                                  "new_sincronizadoem": "@utcNow()",
                                  "new_Veiculo@odata.bind": "@concat('/cr40f_veiculoses(',first(body('Filtrar_Veiculo_Dataverse'))?['cr40f_veiculosid'],')')",
                                  "new_Motorista@odata.bind": "@concat('/cr40f_funcionarioses(',first(body('Filtrar_Motorista_Dataverse'))?['cr40f_funcionariosid'],')')"
                                }
                              }
                            },
                            "runAfter": {
                              "Atualizar_Mapeamento_Motorista": ["Succeeded"]
                            }
                          }
                        },
                        "else": {
                          "actions": {
                            "Upsert_Evento_Sem_Motorista": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                                  "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
                                  "operationId": "UpdateRecord"
                                },
                                "parameters": {
                                  "entityName": "new_eventoinfleets",
                                  "recordId": "@items('Processar_Eventos')?['id']",
                                  "prefer": "return=representation",
                                  "accept": "application/json;odata.metadata=full",
                                  "item": {
                                    "new_nome": "@concat(items('Processar_Eventos')?['slugName'],' | ',items('Processar_Eventos')?['reportedAt'])",
                                    "new_infleeteventid": "@items('Processar_Eventos')?['id']",
                                    "new_infleetvehicleid": "@items('Processar_Eventos')?['vehicleId']",
                                    "new_infleetdriverid": "@coalesce(items('Processar_Eventos')?['driver']?['id'],items('Processar_Eventos')?['driverId'])",
                                    "new_placanormalizada": "@toUpper(replace(items('Processar_Eventos')?['vehicle']?['plate'],'-',''))",
                                    "new_nomemotoristarecebido": "@items('Processar_Eventos')?['driver']?['name']",
                                    "new_slug": "@items('Processar_Eventos')?['slugName']",
                                    "new_descricao": "@items('Processar_Eventos')?['slugName']",
                                    "new_reportadoem": "@items('Processar_Eventos')?['reportedAt']",
                                    "new_velocidaderegistrada": "@coalesce(items('Processar_Eventos')?['attributes']?['speed'],items('Processar_Eventos')?['attributes']?['velocity'],0)",
                                    "new_limitedevelocidade": "@coalesce(items('Processar_Eventos')?['geofence']?['maxSpeed'],0)",
                                    "new_endereco": "@items('Processar_Eventos')?['address']",
                                    "new_latitude": "@items('Processar_Eventos')?['latitude']",
                                    "new_longitude": "@items('Processar_Eventos')?['longitude']",
                                    "new_cerca": "@items('Processar_Eventos')?['geofence']?['name']",
                                    "new_alarme": "@coalesce(items('Processar_Eventos')?['isAlarm'],false)",
                                    "new_statusmapeamentomotorista": "@if(and(empty(coalesce(items('Processar_Eventos')?['driver']?['id'],items('Processar_Eventos')?['driverId'])),empty(items('Processar_Eventos')?['driver']?['cpf'])),'SEM_MOTORISTA',if(equals(length(body('Filtrar_Motorista_Dataverse')),0),'NAO_ENCONTRADO','DUPLICADO'))",
                                    "new_sincronizadoem": "@utcNow()",
                                    "new_Veiculo@odata.bind": "@concat('/cr40f_veiculoses(',first(body('Filtrar_Veiculo_Dataverse'))?['cr40f_veiculosid'],')')"
                                  }
                                }
                              }
                            }
                          }
                        },
                        "runAfter": {
                          "Filtrar_Motorista_Dataverse": ["Succeeded"]
                        }
                      }
                    },
                    "runAfter": {
                      "Upsert_Resumo_Diario": ["Succeeded"]
                    }
                  }
                },
                "else": {
                  "actions": {}
                },
                "runAfter": {
                  "Filtrar_Veiculo_Dataverse": ["Succeeded"]
                }
              }
            },
            "runAfter": {
              "Listar_Eventos_Relevantes_Infleet": ["Succeeded"]
            }
          }
        },
        "runAfter": {
          "Listar_Motoristas_Dataverse": ["Succeeded"]
        }
      }
    },
    "outputs": {}
  }
}
