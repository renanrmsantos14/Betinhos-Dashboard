{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "$authentication": {
        "defaultValue": {},
        "type": "SecureObject"
      },
      "$connections": {
        "defaultValue": {},
        "type": "Object"
      }
    },
    "triggers": {
      "Recorrencia_Diaria": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Day",
          "interval": 1,
          "schedule": {
            "hours": [4],
            "minutes": [0]
          },
          "timeZone": "E. South America Standard Time"
        },
        "runtimeConfiguration": {
          "concurrency": {
            "runs": 1
          }
        }
      }
    },
    "actions": {
      "Listar_Veiculos_Infleet": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/__INFLEET_API_NAME__",
            "connectionName": "__INFLEET_CONNECTION_REFERENCE__",
            "operationId": "ExecuteGraphQL"
          },
          "parameters": {
            "body/operationName": "ListVehicles",
            "body/query": "query ListVehicles { listVehicles(limit: 1000) { id plate displayName brand model year } }",
            "body/variables": {}
          }
        },
        "runAfter": {}
      },
      "Listar_Motoristas_Infleet": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/__INFLEET_API_NAME__",
            "connectionName": "__INFLEET_CONNECTION_REFERENCE__",
            "operationId": "ExecuteGraphQL"
          },
          "parameters": {
            "body/operationName": "ListDriversPaginated",
            "body/query": "query ListDriversPaginated($limit: Int, $offset: Int) { listDriversPaginated(limit: $limit, offset: $offset) { id cpf name active } }",
            "body/variables": {
              "limit": 5000,
              "offset": 0
            }
          }
        },
        "runAfter": {
          "Listar_Veiculos_Infleet": ["Succeeded"]
        }
      },
      "Selecionar_Ids_Veiculos": {
        "type": "Select",
        "inputs": {
          "from": "@body('Listar_Veiculos_Infleet')?['data']?['listVehicles']",
          "select": "@item()?['id']"
        },
        "runAfter": {
          "Listar_Motoristas_Infleet": ["Succeeded"]
        }
      },
      "Listar_Veiculos_Dataverse": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
            "operationId": "ListRecords"
          },
          "parameters": {
            "entityName": "cr40f_veiculoses",
            "$select": "cr40f_veiculosid,cr40f_placa,new_infleetvehicleid,new_placanormalizada"
          }
        },
        "runtimeConfiguration": {
          "paginationPolicy": {
            "minimumItemCount": 5000
          }
        },
        "runAfter": {
          "Selecionar_Ids_Veiculos": ["Succeeded"]
        }
      },
      "Listar_Motoristas_Dataverse": {
        "type": "OpenApiConnection",
        "inputs": {
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
            "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
            "operationId": "ListRecords"
          },
          "parameters": {
            "entityName": "cr40f_funcionarioses",
            "$select": "cr40f_funcionariosid,cr40f_numerodocpf,new_infleetdriverid,new_cpfnormalizado"
          }
        },
        "runtimeConfiguration": {
          "paginationPolicy": {
            "minimumItemCount": 5000
          }
        },
        "runAfter": {
          "Listar_Veiculos_Dataverse": ["Succeeded"]
        }
      },
      "Mapear_Veiculos_Infleet": {
        "type": "Foreach",
        "foreach": "@body('Listar_Veiculos_Infleet')?['data']?['listVehicles']",
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 10
          }
        },
        "actions": {
          "Filtrar_Veiculo_Canonico_Por_Placa": {
            "type": "Query",
            "inputs": {
              "from": "@body('Listar_Veiculos_Dataverse')?['value']",
              "where": "@equals(toUpper(replace(replace(trim(coalesce(item()?['cr40f_placa'],'')),'-',''),' ','')),toUpper(replace(replace(trim(coalesce(items('Mapear_Veiculos_Infleet')?['plate'],'')),'-',''),' ','')))"
            }
          },
          "Vincular_Veiculo_Quando_Unico": {
            "type": "If",
            "expression": {
              "equals": [
                "@length(body('Filtrar_Veiculo_Canonico_Por_Placa'))",
                1
              ]
            },
            "actions": {
              "Atualizar_Identidade_Infleet_Veiculo": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
                    "operationId": "UpdateRecord"
                  },
                  "parameters": {
                    "entityName": "cr40f_veiculoses",
                    "recordId": "@first(body('Filtrar_Veiculo_Canonico_Por_Placa'))?['cr40f_veiculosid']",
                    "prefer": "return=representation",
                    "accept": "application/json;odata.metadata=full",
                    "item": {
                      "new_infleetvehicleid": "@items('Mapear_Veiculos_Infleet')?['id']",
                      "new_placanormalizada": "@toUpper(replace(replace(trim(items('Mapear_Veiculos_Infleet')?['plate']),'-',''),' ',''))",
                      "new_ultimasincronizacaoinfleet": "@utcNow()"
                    }
                  }
                }
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Filtrar_Veiculo_Canonico_Por_Placa": ["Succeeded"]
            }
          }
        },
        "runAfter": {
          "Listar_Motoristas_Dataverse": ["Succeeded"]
        }
      },
      "Mapear_Motoristas_Infleet": {
        "type": "Foreach",
        "foreach": "@body('Listar_Motoristas_Infleet')?['data']?['listDriversPaginated']",
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 10
          }
        },
        "actions": {
          "Filtrar_Funcionario_Canonico_Por_CPF": {
            "type": "Query",
            "inputs": {
              "from": "@body('Listar_Motoristas_Dataverse')?['value']",
              "where": "@and(not(empty(items('Mapear_Motoristas_Infleet')?['cpf'])),equals(replace(replace(replace(trim(coalesce(item()?['cr40f_numerodocpf'],'')),'.',''),'-',''),' ',''),replace(replace(replace(trim(items('Mapear_Motoristas_Infleet')?['cpf']),'.',''),'-',''),' ','')))"
            }
          },
          "Vincular_Motorista_Quando_Unico": {
            "type": "If",
            "expression": {
              "equals": [
                "@length(body('Filtrar_Funcionario_Canonico_Por_CPF'))",
                1
              ]
            },
            "actions": {
              "Atualizar_Identidade_Infleet_Funcionario": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
                    "operationId": "UpdateRecord"
                  },
                  "parameters": {
                    "entityName": "cr40f_funcionarioses",
                    "recordId": "@first(body('Filtrar_Funcionario_Canonico_Por_CPF'))?['cr40f_funcionariosid']",
                    "prefer": "return=representation",
                    "accept": "application/json;odata.metadata=full",
                    "item": {
                      "new_infleetdriverid": "@items('Mapear_Motoristas_Infleet')?['id']",
                      "new_cpfnormalizado": "@replace(replace(replace(trim(items('Mapear_Motoristas_Infleet')?['cpf']),'.',''),'-',''),' ','')",
                      "new_ultimasincronizacaoinfleet": "@utcNow()"
                    }
                  }
                }
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Filtrar_Funcionario_Canonico_Por_CPF": ["Succeeded"]
            }
          }
        },
        "runAfter": {
          "Mapear_Veiculos_Infleet": ["Succeeded"]
        }
      },
      "Processar_Ultimos_3_Dias": {
        "type": "Foreach",
        "foreach": "@createArray(-2,-1,0)",
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 1
          }
        },
        "actions": {
          "Data_Local": {
            "type": "Compose",
            "inputs": "@formatDateTime(addDays(convertTimeZone(utcNow(),'UTC','E. South America Standard Time'),items('Processar_Ultimos_3_Dias')),'yyyy-MM-dd')"
          },
          "Janela_Inicio_UTC": {
            "type": "Compose",
            "inputs": "@convertTimeZone(concat(outputs('Data_Local'),'T00:00:00'),'E. South America Standard Time','UTC','yyyy-MM-ddTHH:mm:ssZ')",
            "runAfter": {
              "Data_Local": ["Succeeded"]
            }
          },
          "Janela_Fim_UTC": {
            "type": "Compose",
            "inputs": "@convertTimeZone(concat(formatDateTime(addDays(outputs('Data_Local'),1),'yyyy-MM-dd'),'T00:00:00'),'E. South America Standard Time','UTC','yyyy-MM-ddTHH:mm:ssZ')",
            "runAfter": {
              "Janela_Inicio_UTC": ["Succeeded"]
            }
          },
          "Listar_Resumos_Veiculos_Infleet": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/__INFLEET_API_NAME__",
                "connectionName": "__INFLEET_CONNECTION_REFERENCE__",
                "operationId": "ExecuteGraphQL"
              },
              "parameters": {
                "body/operationName": "VehiclesSummaries",
                "body/query": "query VehiclesSummaries($filter: VehiclesSummariesFilterInput!) { vehiclesSummaries(filter: $filter) { vehicleId distanceTraveled averageSpeed maximumSpeed engineIdle timeStopped timeStoppedWithIgnitionOn timeWithIgnitionOn timeOverSpeed positions } }",
                "body/variables": {
                  "filter": {
                    "occurredAt": {
                      "startAt": "@outputs('Janela_Inicio_UTC')",
                      "endAt": "@outputs('Janela_Fim_UTC')"
                    },
                    "vehicleIds": "@body('Selecionar_Ids_Veiculos')"
                  }
                }
              }
            },
            "runAfter": {
              "Janela_Fim_UTC": ["Succeeded"]
            }
          },
          "Listar_Medicoes_Diarias_Infleet": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/__INFLEET_API_NAME__",
                "connectionName": "__INFLEET_CONNECTION_REFERENCE__",
                "operationId": "ExecuteGraphQL"
              },
              "parameters": {
                "body/operationName": "DailyWorkMeasures",
                "body/query": "query DailyWorkMeasures($filter: DailyWorkMeasuresFilterInput) { dailyWorkMeasures(filter: $filter) { vehicleId date initialOdometer finalOdometer distanceTraveled timeWithIgnitionOn } }",
                "body/variables": {
                  "filter": {
                    "occurredAt": {
                      "startAt": "@outputs('Janela_Inicio_UTC')",
                      "endAt": "@outputs('Janela_Fim_UTC')"
                    },
                    "vehicleIds": "@body('Selecionar_Ids_Veiculos')"
                  }
                }
              }
            },
            "runAfter": {
              "Listar_Resumos_Veiculos_Infleet": ["Succeeded"]
            }
          },
          "Listar_Historico_Motoristas_Infleet": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/__INFLEET_API_NAME__",
                "connectionName": "__INFLEET_CONNECTION_REFERENCE__",
                "operationId": "ExecuteGraphQL"
              },
              "parameters": {
                "body/operationName": "ListVehicleDriverHistories",
                "body/query": "query ListVehicleDriverHistories($filter: ListVehicleDriverHistoriesFilterInput, $limit: Int, $offset: Int) { listVehicleDriverHistories(filter: $filter, limit: $limit, offset: $offset) { total vehicleDriverHistories { id vehicleId driverId category occurredAt driver { id cpf name } } } }",
                "body/variables": {
                  "filter": {
                    "startedAt": "@outputs('Janela_Inicio_UTC')",
                    "endedAt": "@outputs('Janela_Fim_UTC')"
                  },
                  "limit": 10000,
                  "offset": 0
                }
              }
            },
            "runAfter": {
              "Listar_Medicoes_Diarias_Infleet": ["Succeeded"]
            }
          },
          "Listar_Eventos_Relevantes_Infleet": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "apiId": "/providers/Microsoft.PowerApps/apis/__INFLEET_API_NAME__",
                "connectionName": "__INFLEET_CONNECTION_REFERENCE__",
                "operationId": "ExecuteGraphQL"
              },
              "parameters": {
                "body/operationName": "ListRelevantEvents",
                "body/query": "query ListRelevantEvents($filter: ListEventsFilterInput!, $limit: Int, $offset: Int) { listEvents(filter: $filter, limit: $limit, offset: $offset) { id reportedAt slugName vehicleId address latitude longitude isAlarm attributes vehicle { id plate } driverId driver { id cpf name } geofence { name maxSpeed } } }",
                "body/variables": {
                    "filter": {
                      "reportedAt": {
                        "startAt": "@outputs('Janela_Inicio_UTC')",
                        "endAt": "@outputs('Janela_Fim_UTC')"
                      },
                      "slugNames": [
                        "routeOverspeed",
                        "deviceOverspeed",
                        "hardAcceleration",
                        "hardBraking",
                        "hardCornering",
                        "deviceIdle",
                        "geofenceEnter",
                        "geofenceExit",
                        "driverChanged"
                      ],
                      "vehicleIds": "@body('Selecionar_Ids_Veiculos')"
                    },
                    "limit": 10000,
                    "offset": 0
                }
              }
            },
            "runAfter": {
              "Listar_Historico_Motoristas_Infleet": ["Succeeded"]
            }
          },
          "Processar_Veiculos": {
            "type": "Foreach",
            "foreach": "@body('Listar_Veiculos_Infleet')?['data']?['listVehicles']",
            "runtimeConfiguration": {
              "concurrency": {
                "repetitions": 3
              }
            },
            "actions": {
              "Filtrar_Veiculo_Dataverse": {
                "type": "Query",
                "inputs": {
                  "from": "@body('Listar_Veiculos_Dataverse')?['value']",
                  "where": "@equals(toUpper(replace(replace(trim(coalesce(item()?['cr40f_placa'],'')),'-',''),' ','')),toUpper(replace(replace(trim(coalesce(items('Processar_Veiculos')?['plate'],'')),'-',''),' ','')))"
                }
              },
              "Veiculo_Canonico_Unico": {
                "type": "If",
                    "expression": {
                      "and": [
                        {
                          "equals": [
                            "@length(body('Filtrar_Veiculo_Dataverse'))",
                            1
                          ]
                        },
                        {
                          "contains": [
                            "@string(body('Listar_Resumos_Veiculos_Infleet')?['data']?['vehiclesSummaries'])",
                            "@items('Processar_Veiculos')?['id']"
                          ]
                        }
                      ]
                    },
                "actions": {
                  "Filtrar_Resumo_Veiculo": {
                    "type": "Query",
                    "inputs": {
                      "from": "@body('Listar_Resumos_Veiculos_Infleet')?['data']?['vehiclesSummaries']",
                      "where": "@equals(item()?['vehicleId'],items('Processar_Veiculos')?['id'])"
                    },
                    "runAfter": {}
                  },
                  "Filtrar_Medicao_Diaria_Veiculo": {
                    "type": "Query",
                    "inputs": {
                      "from": "@body('Listar_Medicoes_Diarias_Infleet')?['data']?['dailyWorkMeasures']",
                      "where": "@equals(item()?['vehicleId'],items('Processar_Veiculos')?['id'])"
                    },
                    "runAfter": {
                      "Filtrar_Resumo_Veiculo": ["Succeeded"]
                    }
                  },
                  "Filtrar_Eventos_Veiculo": {
                    "type": "Query",
                    "inputs": {
                      "from": "@body('Listar_Eventos_Relevantes_Infleet')?['data']?['listEvents']",
                      "where": "@equals(item()?['vehicleId'],items('Processar_Veiculos')?['id'])"
                    },
                    "runAfter": {
                      "Filtrar_Medicao_Diaria_Veiculo": ["Succeeded"]
                    }
                  },
                  "Filtrar_Excessos_Velocidade": {
                    "type": "Query",
                    "inputs": {
                      "from": "@body('Filtrar_Eventos_Veiculo')",
                      "where": "@or(equals(item()?['slugName'],'routeOverspeed'),equals(item()?['slugName'],'deviceOverspeed'))"
                    },
                    "runAfter": {
                      "Filtrar_Eventos_Veiculo": ["Succeeded"]
                    }
                  },
                  "Upsert_Resumo_Diario": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "connectionName": "__DATAVERSE_CONNECTION_REFERENCE__",
                        "operationId": "UpdateRecord"
                      },
                      "parameters": {
                        "entityName": "new_telemetriadiariainfleets",
                        "recordId": "@concat(substring(items('Processar_Veiculos')?['id'],0,28),replace(outputs('Data_Local'),'-',''))",
                        "prefer": "return=representation",
                        "accept": "application/json;odata.metadata=full",
                        "item": {
                          "new_nome": "@concat(items('Processar_Veiculos')?['plate'],' | ',outputs('Data_Local'))",
                          "new_chavetelemetria": "@concat(items('Processar_Veiculos')?['id'],'|',outputs('Data_Local'))",
                          "new_infleetvehicleid": "@items('Processar_Veiculos')?['id']",
                          "new_placanormalizada": "@toUpper(replace(items('Processar_Veiculos')?['plate'],'-',''))",
                          "new_data": "@outputs('Data_Local')",
                          "new_distanciapercorridakm": "@coalesce(first(body('Filtrar_Resumo_Veiculo'))?['distanceTraveled'],first(body('Filtrar_Medicao_Diaria_Veiculo'))?['distanceTraveled'],0)",
                          "new_odometroinicial": "@first(body('Filtrar_Medicao_Diaria_Veiculo'))?['initialOdometer']",
                          "new_odometrofinal": "@first(body('Filtrar_Medicao_Diaria_Veiculo'))?['finalOdometer']",
                          "new_velocidademedia": "@coalesce(first(body('Filtrar_Resumo_Veiculo'))?['averageSpeed'],0)",
                          "new_velocidademaxima": "@coalesce(first(body('Filtrar_Resumo_Veiculo'))?['maximumSpeed'],0)",
                          "new_tempoemmovimentomin": "@int(div(sub(coalesce(first(body('Filtrar_Resumo_Veiculo'))?['timeWithIgnitionOn'],0),coalesce(first(body('Filtrar_Resumo_Veiculo'))?['timeStoppedWithIgnitionOn'],0)),60))",
                          "new_tempoparadomin": "@int(div(coalesce(first(body('Filtrar_Resumo_Veiculo'))?['timeStopped'],0),60))",
                          "new_tempoparadocomignicaomin": "@int(div(coalesce(first(body('Filtrar_Resumo_Veiculo'))?['timeStoppedWithIgnitionOn'],0),60))",
                          "new_tempocomignicaoligadamin": "@int(div(coalesce(first(body('Filtrar_Resumo_Veiculo'))?['timeWithIgnitionOn'],first(body('Filtrar_Medicao_Diaria_Veiculo'))?['timeWithIgnitionOn'],0),60))",
                          "new_tempomotorociosomin": "@int(div(coalesce(first(body('Filtrar_Resumo_Veiculo'))?['engineIdle'],0),60))",
                          "new_tempoacimavelocidademin": "@int(div(coalesce(first(body('Filtrar_Resumo_Veiculo'))?['timeOverSpeed'],0),60))",
                          "new_quantidadeposicoes": "@int(coalesce(first(body('Filtrar_Resumo_Veiculo'))?['positions'],0))",
                          "new_quantidadeeventos": "@length(body('Filtrar_Eventos_Veiculo'))",
                          "new_excessosdevelocidade": "@length(body('Filtrar_Excessos_Velocidade'))",
                          "new_janelainicioutc": "@outputs('Janela_Inicio_UTC')",
                          "new_janelafimutc": "@outputs('Janela_Fim_UTC')",
                          "new_sincronizadoem": "@utcNow()",
                          "new_Veiculo@odata.bind": "@concat('/cr40f_veiculoses(',first(body('Filtrar_Veiculo_Dataverse'))?['cr40f_veiculosid'],')')"
                        }
                      }
                    },
                    "runAfter": {
                      "Filtrar_Excessos_Velocidade": ["Succeeded"]
                    }
                  },
                  "Processar_Eventos": {
                    "type": "Foreach",
                    "foreach": "@body('Filtrar_Eventos_Veiculo')",
                    "runtimeConfiguration": {
                      "concurrency": {
                        "repetitions": 20
                      }
                    },
                    "actions": {
                      "Filtrar_Historico_Motorista_Evento": {
                        "type": "Query",
                        "inputs": {
                          "from": "@body('Listar_Historico_Motoristas_Infleet')?['data']?['listVehicleDriverHistories']?['vehicleDriverHistories']",
                          "where": "@and(equals(item()?['vehicleId'],items('Processar_Eventos')?['vehicleId']),lessOrEquals(ticks(item()?['occurredAt']),ticks(items('Processar_Eventos')?['reportedAt'])))"
                        }
                      },
                      "Resolver_Motorista_Por_Historico_Ou_Fallback": {
                        "type": "If",
                        "expression": {
                          "equals": [
                            "@length(body('Filtrar_Historico_Motorista_Evento'))",
                            0
                          ]
                        },
                        "actions": {
                          "Obter_Motorista_No_Horario_Infleet": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "apiId": "/providers/Microsoft.PowerApps/apis/__INFLEET_API_NAME__",
                                "connectionName": "__INFLEET_CONNECTION_REFERENCE__",
                                "operationId": "ExecuteGraphQL"
                              },
                              "parameters": {
                                "body/operationName": "GetDriverAtByVehicleId",
                                "body/query": "query GetDriverAtByVehicleId($vehicleId: ID!, $atTime: DateTime!) { getDriverAtByVehicleId(vehicleId: $vehicleId, atTime: $atTime) { id cpf name } }",
                                "body/variables": {
                                  "vehicleId": "@items('Processar_Eventos')?['vehicleId']",
                                  "atTime": "@items('Processar_Eventos')?['reportedAt']"
                                }
                              }
                            }
                          }
                        },
                        "else": {
                          "actions": {}
                        },
                        "runAfter": {
                          "Filtrar_Historico_Motorista_Evento": ["Succeeded"]
                        }
                      },
                      "Motorista_Resolvido": {
                        "type": "Compose",
                        "inputs": "@if(greater(length(body('Filtrar_Historico_Motorista_Evento')),0),first(body('Filtrar_Historico_Motorista_Evento'))?['driver'],body('Obter_Motorista_No_Horario_Infleet')?['data']?['getDriverAtByVehicleId'])",
                        "runAfter": {
                          "Resolver_Motorista_Por_Historico_Ou_Fallback": ["Succeeded"]
                        }
                      },
                      "Filtrar_Motorista_Dataverse": {
                        "type": "Query",
                        "inputs": {
                          "from": "@body('Listar_Motoristas_Dataverse')?['value']",
                          "where": "@or(and(not(empty(outputs('Motorista_Resolvido')?['id'])),equals(item()?['new_infleetdriverid'],outputs('Motorista_Resolvido')?['id'])),and(not(empty(outputs('Motorista_Resolvido')?['cpf'])),equals(replace(replace(replace(trim(coalesce(item()?['cr40f_numerodocpf'],'')),'.',''),'-',''),' ',''),replace(replace(replace(trim(outputs('Motorista_Resolvido')?['cpf']),'.',''),'-',''),' ',''))))"
                        },
                        "runAfter": {
                          "Motorista_Resolvido": ["Succeeded"]
                        }
                      },
                      "Motorista_Canonico_Unico": {
                        "type": "If",
                        "expression": {
                          "equals": [
