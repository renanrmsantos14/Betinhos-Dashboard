      .cc-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--t1);
      }
      .cc-sub {
        font-size: 10px;
        color: var(--t3);
        margin-top: 2px;
        font-weight: 500;
      }
      .cc-kv {
        font-size: 15px;
        font-weight: 800;
        color: var(--t1);
        text-align: right;
      }
      .cc-kl {
        font-size: 10px;
        color: var(--t3);
