    <style>
      /* ===== RESET & VARIÁVEIS ===== */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      :root {
        --bg: #f0f0f0;
        --surf: #ffffff;
        --surf2: #fcfcfb;
        --b1: #e2e8f0;
        --b2: #c7d2e2;
        --t1: #0f172a;
        --t2: #475569;
        --t3: #94a3b8;
        --navy: #001a3d;
        --navy-2: #0b2d5a;
        --blue: #2159d2;
        --blue-l: #edf3ff;
        --blue-d: #0b2d5a;
        --blue-g: var(--blue);
        --teal: #2159d2;
        --teal-l: #edf3ff;
        --purple: #6b4b9b;
        --purple-l: #f4efff;
        --orange: #9a4e12;
        --orange-l: #fff0e5;
        --green: #168f57;
        --green-l: #eaf8f1;
        --red: #c12f45;
        --red-l: #fff0f3;
        --yellow: #b17a00;
        --yellow-l: #fff7df;
        --gold: #b17a00;
        --r6: 6px;
        --r8: 8px;
        --r12: 12px;
        --r16: 17px;
        --s1: 0 8px 24px rgba(0, 26, 61, 0.045);
        --s2: 0 10px 28px rgba(0, 26, 61, 0.045);
        --s3: 0 18px 42px rgba(15, 23, 42, 0.18), 0 2px 7px rgba(15, 23, 42, 0.08);
        --font: "Manrope", "Segoe UI", sans-serif;
        --topbar-h: 64px;
        --brand-logo-size: 40px;
        --brand-logo-radius: 11px;
        --space-050: 4px;
        --space-075: 6px;
        --space-100: 8px;
        --space-150: 12px;
        --space-200: 16px;
        --space-300: 24px;
        --control-gap: var(--space-100);
        --card-gap: var(--space-150);
        --section-gap: var(--space-200);
        --page-gap: var(--section-gap);
        --content-max: 1500px;
        --surface-pad: 16px;
        --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
        --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
        --dur-fast: 150ms;
        --dur-med: 200ms;
        --dur-slow: 300ms;
      }
      body {
        background: var(--bg);
        color: var(--t1);
        font-family: var(--font);
        font-size: 13px;
        line-height: 1.5;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }
      .topbar {
        height: var(--topbar-h);
        background: var(--surf);
        border-bottom: 1px solid var(--b1);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        position: sticky;
        top: 0;
        z-index: 300;
        box-shadow:
          0 1px 0 var(--b1),
          var(--s1);
      }
      .tb-brand {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .tb-logo {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: transparent;
        display: grid;
        place-items: center;
        box-shadow: 0 2px 8px rgba(26, 108, 245, 0.35);
        overflow: hidden;
        border: 2px solid white;
      }
      .tb-logo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .tb-logo-fallback::after {
        content: "B";
        color: var(--blue);
        font-size: 16px;
        font-weight: 800;
      }
      .tb-name {
        font-size: 15px;
        font-weight: 800;
        color: var(--t1);
        letter-spacing: -0.3px;
      }
      .tb-sub {
        font-size: 11px;
        color: var(--t3);
        font-weight: 500;
      }
      .tb-right {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .env-pill {
        font-size: 10px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .env-prod {
        background: #eaf8f1;
        color: #168f57;
        border: 1px solid #eaf8f1;
      }
      .env-dev {
        background: #fff7df;
        color: #b17a00;
        border: 1px solid #fff7df;
      }
      .env-local {
        background: var(--blue-l);
        color: var(--blue);
        border: 1px solid #edf3ff;
      }
      .ts {
        font-size: 11px;
        color: var(--t3);
        font-weight: 500;
      }
      .btn-ic {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        background: transparent;
        border: 1px solid var(--b1);
        border-radius: var(--r8);
        color: var(--t2);
        cursor: pointer;
        font-size: 16px;
        transition:
          background-color var(--dur-fast) ease,
          border-color var(--dur-fast) ease,
          color var(--dur-fast) ease,
          transform var(--dur-fast) var(--ease-out);
      }
      .btn-ic:hover {
        background: var(--bg);
        border-color: var(--b2);
        color: var(--t1);
      }
      .btn-ic:active {
        transform: scale(0.96);
      }
      .btn-ic:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .btn-ic.spin svg,
      .btn-ic.spin {
        animation: spinI 0.8s linear infinite;
      }
      @keyframes spinI {
        to {
          transform: rotate(360deg);
        }
      }
      .shell {
        display: flex;
        height: calc(100vh - var(--topbar-h));
      }
      .sidebar {
        width: 220px;
        flex-shrink: 0;
        background: var(--surf);
        border-right: 1px solid var(--b1);
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        padding: 8px 0 16px;
      }
      .sb-section {
        padding: 14px 16px 5px;
        font-size: 10px;
        font-weight: 700;
        color: var(--t3);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }
      .sb-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 8px 12px;
        margin: 1px 8px;
        border-radius: var(--r8);
        font-size: 13px;
        font-weight: 500;
        color: var(--t2);
        cursor: pointer;
        transition:
          background-color var(--dur-fast) ease,
          color var(--dur-fast) ease,
          transform var(--dur-fast) var(--ease-out);
        user-select: none;
      }
      .sb-item:hover {
        background: var(--bg);
        color: var(--t1);
      }
      .sb-item:active {
        transform: scale(0.985);
      }
      .sb-item.act {
        background: var(--blue-l);
        color: var(--blue);
        font-weight: 700;
      }
      .sb-item.act .sb-icon {
        filter: none;
      }
      .sb-icon {
        font-size: 14px;
        width: 20px;
        text-align: center;
        flex-shrink: 0;
        opacity: 0.75;
      }
      .sb-item.act .sb-icon {
        opacity: 1;
      }
      .sb-badge {
        margin-left: auto;
        font-size: 10px;
        font-weight: 700;
        background: var(--b1);
        color: var(--t2);
        padding: 1px 7px;
        border-radius: 20px;
        min-width: 22px;
        text-align: center;
        transition:
          background-color var(--dur-fast) ease,
          color var(--dur-fast) ease;
      }
      .sb-item.act .sb-badge {
