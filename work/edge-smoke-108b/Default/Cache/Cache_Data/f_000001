        flex-direction: column;
        gap: 5px;
        margin: 0;
        align-items: flex-end;
        flex-wrap: wrap;
      }
      /* Unified chart card header — matches Total Produzido pattern */
      .cc-hdr2 {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 0 0 var(--space-150);
        gap: var(--section-gap);
      }
      .cc-hdr2 .cc2-label {
        font-size: 10px;
        font-weight: 700;
        color: var(--t3);
        letter-spacing: .4px;
        text-transform: uppercase;
        margin-bottom: 4px;
      }
      .cc-hdr2 .cc2-bigval {
        font-size: 22px;
        font-weight: 800;
        color: var(--t1);
        line-height: 1.1;
      }
      .cc-hdr2 .cc2-sub {
        font-size: 11px;
        color: var(--t3);
        margin-top: 3px;
      }
      /* Status chip for non-badge contexts */
      .stat-chip {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 3px 8px; border-radius: 20px;
        font-size: 11px; font-weight: 700; white-space: nowrap;
      }
      .meta-progress-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }
      .meta-progress-bar-outer {
        flex: 1;
        min-width: 120px;
        height: 8px;
        background: var(--b1);
        border-radius: 99px;
        overflow: hidden;
      }
      .meta-progress-bar-inner {
        height: 100%;
        border-radius: 99px;
        transition: width var(--dur-slow) var(--ease-out);
      }
      .meta-kpi-pill {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
        background: var(--surf2);
        border: 1px solid var(--b1);
        border-radius: 8px;
        padding: 6px 10px;
        font-size: 10px;
        color: var(--t3);
        font-weight: 600;
        gap: 1px;
        white-space: nowrap;
      }
      .meta-kpi-pill strong {
        font-size: 13px;
        font-weight: 800;
        color: var(--t1);
      }
      .meta-kpi-pills {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
        gap: var(--control-gap);
        padding: 0 var(--surface-pad) var(--space-150);
      }
      .metric-list {
        display: grid;
        gap: var(--space-075);
        margin-top: var(--space-150);
      }
      .metric-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        font-size: 12px;
        color: var(--t2);
      }
      .metric-line b {
        color: var(--t1);
        font-variant-numeric: tabular-nums;
      }
      .metric-table-wrap {
        min-width: 0;
        max-width: 100%;
        overflow-x: auto;
        padding: 0 var(--surface-pad) var(--surface-pad);
      }
      .metric-mobile-list {
        display: none;
      }
      .metric-mobile-row {
        display: grid;
        gap: 8px;
        padding: 12px 0;
        border-bottom: 1px solid var(--b1);
      }
      .metric-mobile-row:last-child {
        border-bottom: 0;
      }
      .metric-mobile-row-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        min-width: 0;
      }
      .metric-mobile-label {
        min-width: 0;
        color: var(--t1);
        font-size: 12px;
        font-weight: 800;
        line-height: 1.25;
      }
      .metric-mobile-stats {
        display: flex;
        align-items: flex-start;
        justify-content: flex-end;
        gap: 10px;
        flex: 0 0 auto;
      }
      .metric-mobile-stats span {
        display: grid;
        gap: 1px;
        justify-items: end;
        min-width: 48px;
      }
      .metric-mobile-stats small {
        color: var(--t3);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .04em;
        text-transform: uppercase;
      }
      .metric-mobile-stats b {
        color: var(--t1);
        font-size: 12px;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }
      .metric-mobile-stats em {
        color: var(--t3);
        font-size: 10px;
        font-style: normal;
        font-weight: 600;
        white-space: nowrap;
      }
      .metric-mobile-progress {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
      }
      .metric-mobile-progress .prg-bg {
        min-width: 0;
        height: 6px;
      }
      .metric-mobile-progress > span {
        flex: 0 0 auto;
        color: var(--t3);
        font-size: 10px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
      }
      .metric-table-wrap table {
        font-size: 11px;
      }
      .metric-table-wrap thead th {
        position: static;
        cursor: default;
      }
      .metric-note {
        padding: 0 var(--surface-pad) var(--space-150);
        color: var(--t3);
        font-size: 11px;
        font-weight: 600;
      }
      .tc {
        background: var(--surf);
        border: 1px solid var(--b1);
        border-radius: var(--r12);
        box-shadow: var(--s1);
        overflow: hidden;
        margin-bottom: 0;
        transition:
          box-shadow var(--dur-med) var(--ease-out),
          border-color var(--dur-med) ease;
      }
      .dashboard-section {
        display: grid;
        gap: var(--section-gap);
        min-width: 0;
      }
      .dashboard-section--alerts {
        gap: var(--card-gap);
      }
      .dashboard-section--alerts .section-label + .exec-alerts {
        margin-top: calc(var(--control-gap) * -1);
      }
      .page > .kpi-row,
      .page > .cgrid,
      .page > .tc,
      .dashboard-section > .kpi-row,
      .dashboard-section > .cgrid,
      .dashboard-section > .tc {
        min-width: 0;
      }
      .page,
      .page > *,
      .dashboard-section > * {
        min-width: 0;
        max-width: 100%;
      }
      .section-label {
        margin: 0;
        color: var(--t3);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }
      .kpi,
      .cc,
      .tc,
      .exec-alert {
        border-color: var(--b1);
      }
      .tc-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-150) var(--surface-pad);
        border-bottom: 1px solid var(--b1);
        gap: 10px;
        flex-wrap: wrap;
      }
      .tc-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--t1);
      }
      .tc-meta {
        font-size: 11px;
        color: var(--t3);
        font-weight: 500;
      }
      .tc-search {
        height: 30px;
        border: 1.5px solid var(--b1);
        border-radius: var(--r8);
        padding: 0 10px;
        font-size: 12px;
        font-family: var(--font);
        font-weight: 500;
        outline: none;
        transition:
          border-color var(--dur-fast) ease,
          box-shadow var(--dur-med) var(--ease-out);
        min-width: 180px;
        color: var(--t1);
      }
      .tc-search:focus {
        border-color: var(--blue);
      }
      .tc-wrap {
        overflow-x: auto;
        max-height: 420px;
        overflow-y: auto;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
      }
      thead th {
        background: var(--surf2);
        color: var(--t3);
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 9px 14px;
        text-align: left;
        border-bottom: 1px solid var(--b1);
        white-space: nowrap;
        position: sticky;
        top: 0;
        cursor: pointer;
        user-select: none;
        transition:
          background-color var(--dur-fast) ease,
          color var(--dur-fast) ease;
      }
      thead th:hover {
        background: var(--bg);
        color: var(--t1);
      }
      thead th.sa::after {
        content: " ↑";
        color: var(--blue);
      }
      thead th.sd::after {
        content: " ↓";
        color: var(--blue);
      }
      tbody tr {
        border-bottom: 1px solid var(--b1);
        transition: background-color var(--dur-fast) ease;
      }
      tbody tr:last-child {
        border-bottom: none;
      }
      tbody tr:hover {
        background: var(--blue-l);
      }
      td {
        padding: 9px 14px;
        color: var(--t1);
        white-space: nowrap;
        font-weight: 500;
      }
      td.r {
        text-align: right;
        font-variant-numeric: tabular-nums;
      }
      td.dim {
        color: var(--t3);
        font-size: 11px;
        font-weight: 400;
      }
      td.em {
        font-weight: 700;
      }
      td.c {
        text-align: center;
      }
      .rn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        font-size: 10px;
        font-weight: 800;
        background: var(--bg);
        color: var(--t3);
      }
      .rn.r1 {
        background: var(--yellow-l);
        color: var(--yellow);
      }
      .rn.r2 {
        background: #f7f9fc;
        color: #475569;
      }
      .rn.r3 {
        background: var(--orange-l);
        color: var(--orange);
      }
      .bd {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
      }
      .dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        flex-shrink: 0;
      }
      .prg {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .prg-bg {
        flex: 1;
        height: 5px;
        background: var(--bg);
        border-radius: 3px;
        overflow: hidden;
        min-width: 60px;
      }
      .prg-fill {
        height: 100%;
        border-radius: 3px;
        transition: width var(--dur-slow) var(--ease-out);
      }
      .prg-pct {
        font-size: 11px;
        color: var(--t3);
        min-width: 58px;
        text-align: right;
        font-weight: 600;
      }
      .metric-split {
        display: inline-flex;
        flex-direction: column;
        gap: 1px;
        line-height: 1.08;
        vertical-align: middle;
      }
      .metric-split.r {
        align-items: flex-end;
      }
      .metric-primary {
        color: var(--t1);
        font-weight: 800;
        font-variant-numeric: tabular-nums;
      }
      .metric-secondary {
        color: var(--t3);
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
      .empty {
        text-align: center;
        padding: 48px 20px;
        color: var(--t3);
      }
      .ei {
        font-size: 36px;
        margin-bottom: 8px;
      }
      .em-msg {
        font-size: 13px;
        font-weight: 600;
      }
      .ov {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(240, 242, 245, 0.85);
        backdrop-filter: none;
        z-index: 500;
        place-items: center;
      }
      .ov.on {
        display: grid;
      }
      .ov-box {
        background: var(--surf);
        border: 1px solid var(--b1);
        border-radius: var(--r16);
        padding: 32px 48px;
        box-shadow: var(--s3);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
      }
      .ring {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 3px solid var(--b1);
        border-top-color: var(--blue);
        animation: spin 0.7s linear infinite;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      .ring-lbl {
        font-size: 13px;
        color: var(--t2);
        font-weight: 600;
      }
      .page {
        display: none;
      }
      .page.on {
        display: flex;
        flex-direction: column;
        gap: var(--page-gap);
      }
      .page.on > * {
        animation: blockIn 220ms var(--ease-out) both;
      }
      .page.on > *:nth-child(1) { animation-delay: 0ms; }
      .page.on > *:nth-child(2) { animation-delay: 40ms; }
      .page.on > *:nth-child(3) { animation-delay: 80ms; }
      .page.on > *:nth-child(4) { animation-delay: 120ms; }
      .page.on > *:nth-child(5) { animation-delay: 160ms; }
      .page.on > *:nth-child(n + 6) { animation-delay: 180ms; }
      @keyframes pageIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @keyframes blockIn {
        from {
          opacity: 0;
          transform: translateY(18px) scale(0.985);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 1ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 1ms !important;
        }
      }
      @media (max-width: 1200px) {
        .kpi-6 {
          --metric-columns: 3;
        }
        .kpi-5 {
          --metric-columns: 3;
        }
        .exec-alerts {
          grid-template-columns: repeat(2, 1fr);
        }
        .cc-hdr2 {
          flex-direction: column;
          align-items: stretch;
        }
        .inline-indicators {
          flex-direction: row;
          justify-content: flex-start;
          align-items: flex-start;
        }
      }
      @media (max-width: 960px) {
        .kpi-6,
        .kpi-5,
        .kpi-4 {
          --metric-columns: 2;
        }
        .g2 {
          grid-template-columns: 1fr;
        }
        .sidebar {
          display: none;
        }
      }
      @media (max-width: 540px) {
