          padding: var(--space-150);
        }
        .fbar {
          padding: 10px;
        }
        .filter-head {
          display: flex;
          align-items: stretch;
          flex-direction: column;
          gap: var(--space-100);
        }
        .filter-head-left {
          align-items: stretch;
          flex-direction: column;
        }
        .filter-toggle {
          justify-content: space-between;
          width: 100%;
        }
        .filter-summary {
          width: 100%;
        }
        .filter-head-actions,
        .fbar.open .filter-head-actions {
          width: 100%;
          justify-content: flex-start;
        }
        .filter-head-actions .quick-filters,
        .fbar.open .filter-head-actions .quick-filters {
          justify-content: flex-start;
        }
        .filter-row {
          display: grid;
          grid-template-columns: 1fr;
        }
        .ms-wrap {
          min-width: 0;
          width: 100%;
        }
        .kpi-6,
        .kpi-5,
        .kpi-4,
        .kpi-3 {
          --metric-columns: 1;
        }
        .exec-alerts {
          grid-template-columns: 1fr;
        }
        .meta-kpi-pills {
          grid-template-columns: 1fr;
        }
      }
      @container (max-width: 160px) {
        .kpi-right .badge-kpi.badge-lm .bk-val,
