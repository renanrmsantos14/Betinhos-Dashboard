          display: none;
        }
        .badge-kpi {
          height: 21px;
        }
        .badge-kpi .bk-label,
        .badge-kpi .bk-pct {
          padding: 0 4px;
        }
      }
      @container (max-width: 198px) {
        .kpi.executive {
          min-height: 168px;
        }
        .kpi-spark {
          height: 38px;
        }
        .kpi-spark canvas {
          height: 34px !important;
        }
