        align-items: center;
        gap: 6px;
      }
      /* ── KPI comparison chips (LM / LY / META) ── */
      .badge-kpi {
        display: inline-flex;
        align-items: center;
        gap: 0;
        border-radius: 5px;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        border: none;
        height: 22px;
        max-width: 100%;
      }
      .badge-kpi .bk-label {
        padding: 0 5px;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.4px;
        opacity: 0.85;
        height: 100%;
        display: flex;
        align-items: center;
      }
      .badge-kpi .bk-val {
        padding: 0 5px;
        font-size: 10px;
        font-weight: 700;
        height: 100%;
        display: flex;
        align-items: center;
        font-variant-numeric: tabular-nums;
      }
      .badge-kpi .bk-pct {
        padding: 0 5px;
        font-size: 9px;
        font-weight: 800;
        height: 100%;
        display: flex;
        align-items: center;
        gap: 2px;
      }
      /* LM — teal */
      .badge-lm { background: #edf3ff; color: #168f57; }
      .badge-lm .bk-label { background: #2159d2; color: #fff; }
      .badge-lm .bk-pct.du { color: #168f57; }
      .badge-lm .bk-pct.dd { color: #c12f45; }
      /* LY — purple */
      .badge-ly { background: #f4efff; color: #6b4b9b; }
      .badge-ly .bk-label { background: #6b4b9b; color: #fff; }
      .badge-ly .bk-pct.du { color: #6b4b9b; }
      .badge-ly .bk-pct.dd { color: #c12f45; }
      /* META — green when achieved, orange when not */
      .badge-meta { background: #eaf8f1; color: #168f57; }
      .badge-meta .bk-label { background: #168f57; color: #fff; }
      .badge-meta.below { background: #fff0e5; color: #9a4e12; }
      .badge-meta.below .bk-label { background: #9a4e12; }
      /* legacy delta helpers */
      .du { color: var(--green); }
      .dd { color: var(--red); }
      .dn { color: var(--t3); }
      .badge-val { font-weight: 800; font-size: 11px; }
      .badge-delta {
        display: inline-flex; align-items: center; gap: 3px;
        font-size: 9px; font-weight: 700;
      }
      .cgrid {
        display: grid;
        gap: var(--card-gap);
        margin-bottom: 0;
        min-width: 0;
      }
      .g2 {
        grid-template-columns: 1fr 1fr;
      }
      .g1 {
        grid-template-columns: 1fr;
      }
      .cc {
        background: var(--surf);
        border: 1px solid var(--b1);
        border-radius: var(--r12);
        padding: var(--surface-pad);
        box-shadow: var(--s1);
        min-width: 0;
        max-width: 100%;
        transition:
          box-shadow var(--dur-med) var(--ease-out),
          border-color var(--dur-med) ease,
          transform 320ms var(--ease-out);
        position: relative;
      }
      @media (hover: hover) and (pointer: fine) {
        .cc:hover {
          border-color: var(--b2);
          box-shadow: var(--s2);
          transform: translateY(-3px);
        }
      }
      .chart-empty {
        position: absolute;
        left: 16px;
        right: 16px;
        bottom: 16px;
        min-height: 54px;
        display: grid;
        place-items: center;
        border: 1px dashed var(--b2);
        border-radius: var(--r8);
        background: rgba(255,255,255,.82);
        color: var(--t3);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .05em;
        text-transform: uppercase;
        pointer-events: none;
