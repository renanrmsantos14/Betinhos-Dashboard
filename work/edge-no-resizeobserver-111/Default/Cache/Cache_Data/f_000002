    <style>
      /* ===== RESET & VARIÁVEIS ===== */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      :root {
        --bg: #f0f0f0;
        --surf: #ffffff;
        --surf2: #fcfcfb;
        --b1: #e2e8f0;
        --b2: #c7d2e2;
        --t1: #0f172a;
        --t2: #475569;
        --t3: #94a3b8;
        --navy: #001a3d;
        --navy-2: #0b2d5a;
        --blue: #2159d2;
        --blue-l: #edf3ff;
        --blue-d: #0b2d5a;
        --blue-g: var(--blue);
        --teal: #2159d2;
        --teal-l: #edf3ff;
        --purple: #6b4b9b;
        --purple-l: #f4efff;
        --orange: #9a4e12;
        --orange-l: #fff0e5;
        --green: #168f57;
        --green-l: #eaf8f1;
        --red: #c12f45;
        --red-l: #fff0f3;
        --yellow: #b17a00;
        --yellow-l: #fff7df;
        --gold: #b17a00;
        --r6: 6px;
        --r8: 8px;
        --r12: 12px;
        --r16: 17px;
        --s1: 0 8px 24px rgba(0, 26, 61, 0.045);
        --s2: 0 10px 28px rgba(0, 26, 61, 0.045);
        --s3: 0 18px 42px rgba(15, 23, 42, 0.18), 0 2px 7px rgba(15, 23, 42, 0.08);
        --font: "Manrope", "Segoe UI", sans-serif;
        --topbar-h: 64px;
        --brand-logo-size: 40px;
        --brand-logo-radius: 11px;
        --space-050: 4px;
        --space-075: 6px;
        --space-100: 8px;
        --space-150: 12px;
        --space-200: 16px;
        --space-300: 24px;
        --control-gap: var(--space-100);
        --card-gap: var(--space-150);
        --section-gap: var(--space-200);
        --page-gap: var(--section-gap);
        --content-max: 1500px;
        --surface-pad: 16px;
        --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
        --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
        --dur-fast: 150ms;
        --dur-med: 200ms;
        --dur-slow: 300ms;
      }
      body {
        background: var(--bg);
        color: var(--t1);
        font-family: var(--font);
        font-size: 13px;
        line-height: 1.5;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }
      .topbar {
        height: var(--topbar-h);
        background: var(--surf);
        border-bottom: 1px solid var(--b1);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
        position: sticky;
        top: 0;
        z-index: 300;
        box-shadow:
          0 1px 0 var(--b1),
          var(--s1);
      }
      .tb-brand {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .tb-logo {
        width: 36px;
